@page

@model IndexModel
@{
    ViewData["Title"] = "Home page";
}

<div class="container my-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="fw-bold text-light">Кінотека</h1>
            <p class="text-secondary m-0">Колекція найкращих фільмів</p>
        </div>
    </div>

    <div class="row row-cols-1 row-cols-md-3 row-cols-lg-4 g-4">
        @foreach (var item in Model.MovieColections) 
        {
            <div class="col">
                <div class="card h-100 shadow-sm border-0 bg-dark rounded-4 overflow-hidden">
                                  
                    <div class="position-relative">
                        @if (!string.IsNullOrEmpty(item.Image))
                        {
                            <img src="~/Posters/@item.Image" class="card-img-top movie-poster" alt="@item.Name" style="height: 380px; object-fit: cover;">
                        }
                        else
                        {
                            <img src="~/images/no-image.png" class="card-img-top movie-poster" alt="Немає зображення" style="height: 380px; object-fit: cover;">
                        }
                        
               
                        <span class="position-absolute top-0 end-0 m-3 badge bg-black bg-opacity-75 text-warning border border-warning px-2 py-2 rounded-pill fw-bold">
                            ⭐ @item.Rating
                        </span>
                    </div>
                    
                    <div class="card-body d-flex flex-column p-3">
                        <h5 class="card-title text-light fw-bold text-truncate" title="@item.Name">@item.Name</h5>
                        <p class="card-text text-secondary small mb-1"><strong>Режисер:</strong> @item.Director</p>
                        <p class="card-text text-secondary small mb-2"><strong>Жанр:</strong> @item.Genre (@item.YearOfRelease)</p>
                        
                        <p class="card-text text-muted small flex-grow-1" style="display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;">
                            @item.Description
                        </p>

                        <div class="mt-3 pt-2 border-top border-secondary border-opacity-25 text-center">
                            <a asp-page="./Details" asp-route-id="@item.Id" class="btn btn-outline-warning w-100 btn-sm rounded-pill py-2 fw-semibold">
                                <i class="bi bi-eye"></i> Деталі фільму
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>