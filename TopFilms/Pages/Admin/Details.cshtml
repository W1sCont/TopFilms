@page
@model TopFilms.Pages.Admin.DetailsModel
@{
}

<div class="container my-5">
    <div class="card bg-dark border border-secondary border-opacity-25 shadow-lg rounded-4 overflow-hidden p-4 p-md-5">
        <div class="row g-5 align-items-center">
            
            <div class="col-md-4 text-center">
                <div class="position-relative d-inline-block shadow-lg rounded-4 overflow-hidden">
                    @if (!string.IsNullOrEmpty(Model.Movie.Image))
                    {
                        <img src="~/Posters/@Model.Movie.Image" class="img-fluid rounded-4" alt="@Model.Movie.Name" style="width: 100%; max-height: 480px; object-fit: cover;">
                    }
                    else
                    {
                        <img src="~/images/no-image.png" class="img-fluid rounded-4" alt="Немає зображення" style="width: 100%; max-height: 480px; object-fit: cover;">
                    }
                </div>
            </div>

            <div class="col-md-8">
                <div class="d-flex flex-wrap align-items-center gap-3 mb-3">
                    <span class="badge bg-warning text-dark px-3 py-2 rounded-pill fw-bold fs-6 shadow-sm">
                        ⭐ @Model.Movie.Rating
                    </span>
                    <span class="text-secondary fw-semibold">@Model.Movie.YearOfRelease рік</span>
                    <span class="text-secondary">•</span>
                    <span class="badge bg-secondary bg-opacity-25 text-light px-3 py-2 rounded-pill">@Model.Movie.Genre</span>
                </div>

                <h1 class="text-light fw-bold display-4 mb-3">@Model.Movie.Name</h1>
 
                <p class="text-secondary fs-5 mb-4">
                    Режисер: <span class="text-light fw-semibold">@Model.Movie.Director</span>
                </p>

                <div class="mb-5">
                    <h5 class="text-warning fw-bold mb-2">Опис сюжету</h5>
                    <p class="text-secondary lead fs-6 mb-0" style="line-height: 1.8;">
                        @Model.Movie.Description
                    </p>
                </div>

                <div class="d-flex flex-wrap gap-3 pt-3 border-top border-secondary border-opacity-25">
                    <a asp-page="./Index" class="btn btn-outline-light px-4 rounded-pill py-2">
                        &larr; Назад до списку
                    </a>
                    <a asp-page="./Edit" asp-route-id="@Model.Movie.Id" class="btn btn-warning px-4 rounded-pill py-2 fw-bold shadow-sm">
                        ✏️ Редагувати
                    </a>
                    <a asp-page="./Delete" asp-route-id="@Model.Movie.Id" class="btn btn-danger px-4 rounded-pill py-2 fw-bold shadow-sm">
                        🗑️ Видалити
                    </a>
                </div>
            </div>

        </div>
    </div>
</div>